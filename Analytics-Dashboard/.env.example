# Скопіюйте у .env і за потреби змініть. Файл .env у git не потрапляє.
DB_NAME=dashboard
POSTGRES_USER=dashboard_admin
POSTGRES_PASSWORD=change_me_local
# Роль лише для читання, під нею працює API. Пароль задано в db/init/02_views.sql (навчальний стенд);
# якщо змінюєте тут — змініть і там.
DB_RO_PASSWORD=dashboard_ro_local
# Роль лише для внесення даних (INSERT/DELETE таблиць фактів), пароль — там само в 02_views.sql
DB_RW_PASSWORD=dashboard_rw_local
# Порти на цьому ПК
API_PORT=8000
DB_HOST_PORT=5433
# Для запуску без Docker (uvicorn локально, БД з docker compose або локальна):
DB_HOST=localhost
DB_PORT=5433
